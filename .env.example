# Copiez ce fichier en .env et renseignez vos valeurs (jamais commité).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Génération de post (webhook n8n, ticket 13) — voir docs/tickets/13-generation-post.md
# Utilisez l'URL de PRODUCTION du nœud webhook (onglet "Production URL"), pas
# l'URL de test (/webhook-test/...) : celle-ci exige un réarmement manuel dans
# l'éditeur n8n avant chaque appel et ne répond qu'une seule fois.
VITE_N8N_WEBHOOK_GENERATION_POST=

# Profil éditorial (webhook n8n, amendement ticket 09) — analyse les posts existants
# et renvoie une description du style, pour le prompt de génération de post.
# Même remarque : URL de production, pas /webhook-test/...
VITE_N8N_WEBHOOK_PROFIL_EDITORIAL=
